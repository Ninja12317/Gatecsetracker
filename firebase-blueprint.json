{
  "entities": {
    "UserRoot": {
      "title": "UserRoot",
      "description": "Root ownership document for a verified Google Sign-In user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "displayName", "createdAt", "updatedAt"]
    },
    "WorkspaceMeta": {
      "title": "WorkspaceMeta",
      "description": "User workspace preferences, exam countdown settings, bookmarks, and daily autopilot state.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "targetDateIso": {
          "type": "string",
          "maxLength": 40
        },
        "shift": {
          "type": "string",
          "enum": ["Forenoon (09:30 IST)", "Afternoon (14:30 IST)"]
        },
        "dailyGoalMinutes": {
          "type": "number"
        },
        "lastAutopilotIstDate": {
          "type": "string",
          "maxLength": 16
        },
        "lastTrapsIstDate": {
          "type": "string",
          "maxLength": 16
        },
        "themeMode": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "uiScale": {
          "type": "string",
          "enum": ["compact", "default", "comfortable"]
        },
        "contentWidth": {
          "type": "string",
          "enum": ["focused", "wide"]
        },
        "pomodoroWorkMinutes": { "type": "number" },
        "pomodoroShortBreakMinutes": { "type": "number" },
        "pomodoroLongBreakMinutes": { "type": "number" },
        "timerChimeEnabled": { "type": "boolean" },
        "autoHideRemoved2027": { "type": "boolean" },
        "autoAddWrongToMistakes": { "type": "boolean" },
        "showLivePaceTimer": { "type": "boolean" },
        "enableKeyboardShortcuts": { "type": "boolean" },
        "bookmarkedQuestions": {
          "type": "array",
          "description": "Bounded list of up to 200 bookmarked question IDs."
        },
        "bookmarkedTips": {
          "type": "array",
          "description": "Bounded list of up to 200 bookmarked tip IDs."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "theme",
        "targetDateIso",
        "shift",
        "dailyGoalMinutes",
        "lastAutopilotIstDate",
        "bookmarkedQuestions",
        "bookmarkedTips",
        "updatedAt"
      ]
    },
    "SubtopicProgress": {
      "title": "SubtopicProgress",
      "description": "Mastery status, confidence rating, spaced-revision date, and notes for one GATE 2027 subtopic.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subtopicId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "concept_done", "pyqs_done", "mastered"]
        },
        "confidence": {
          "type": "number"
        },
        "lastRevisedAt": {
          "type": "string",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "subtopicId", "status", "confidence", "lastRevisedAt", "notes", "updatedAt"]
    },
    "StudyLog": {
      "title": "StudyLog",
      "description": "Completed deep-work timer or stopwatch session for the 70-day consistency heatmap and Focus Studio timeline.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "subjectId": {
          "type": "string",
          "enum": ["ga", "em", "dl", "coa", "pds", "algo", "toc", "cd", "os", "dbms", "cn"]
        },
        "minutes": {
          "type": "number"
        },
        "mode": {
          "type": "string",
          "enum": ["pomodoro", "stopwatch"]
        },
        "completedAt": {
          "type": "string",
          "maxLength": 40
        },
        "startedAt": {
          "type": "string",
          "maxLength": 40
        },
        "sessionType": {
          "type": "string",
          "enum": ["Concept", "PYQs", "Mock Analysis", "Revision"]
        },
        "goal": {
          "type": "string",
          "maxLength": 200
        },
        "resumeNote": {
          "type": "string",
          "maxLength": 300
        },
        "distractions": {
          "type": "number"
        },
        "presetLabel": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "date", "subjectId", "minutes", "mode", "completedAt", "createdAt"]
    },
    "QuestionAttempt": {
      "title": "QuestionAttempt",
      "description": "Latest graded GATE attempt record for a PYQ question.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isCorrect": {
          "type": "boolean"
        },
        "marksAwarded": {
          "type": "number"
        },
        "maxMarks": {
          "type": "number"
        },
        "attemptedAt": {
          "type": "string",
          "maxLength": 40
        },
        "selectedAnswer": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "questionId", "isCorrect", "marksAwarded", "maxMarks", "attemptedAt", "updatedAt"]
    },
    "MistakeEntry": {
      "title": "MistakeEntry",
      "description": "Captured incorrect or bookmarked question in the user's Mistake Bucket.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "errorTag": {
          "type": "string",
          "enum": ["Conceptual Gap", "Silly Math", "MSQ Trap", "Time Pressure"]
        },
        "wrongCount": {
          "type": "number"
        },
        "lastAttemptedAt": {
          "type": "string",
          "maxLength": 40
        },
        "resolved": {
          "type": "boolean"
        },
        "userNote": {
          "type": "string",
          "maxLength": 2000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "questionId", "errorTag", "wrongCount", "lastAttemptedAt", "resolved", "userNote", "updatedAt"]
    },
    "SavedSketch": {
      "title": "SavedSketch",
      "description": "Compressed HTML5 Canvas rough-work sketch saved for a question.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dataUrl": {
          "type": "string",
          "maxLength": 450000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "questionId", "dataUrl", "updatedAt"]
    },
    "MockTest": {
      "title": "MockTest",
      "description": "Logged Full-Length Mock, Subject Test, or Topic-Wise Test performance record with 1M/2M and penalty diagnostics.",
