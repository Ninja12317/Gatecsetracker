        },
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "source": {
          "type": "string",
          "maxLength": 120
        },
        "subjectId": {
          "type": "string",
          "enum": ["all", "ga", "em", "dl", "coa", "pds", "algo", "toc", "cd", "os", "dbms", "cn"]
        },
        "date": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "type": {
          "type": "string",
          "enum": ["Full-Length Mock", "Subject Test", "Topic-Wise Test"]
        },
        "score": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "normalizedScore": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "accuracy": {
          "type": "number"
        },
        "totalQuestions": {
          "type": "number"
        },
        "attempted": {
          "type": "number"
        },
        "correct": {
          "type": "number"
        },
        "wrong": {
          "type": "number"
        },
        "unattempted": {
          "type": "number"
        },
        "q1Attempted": { "type": "number" },
        "q2Attempted": { "type": "number" },
        "q1Correct": { "type": "number" },
        "q2Correct": { "type": "number" },
        "q1Wrong": { "type": "number" },
        "q2Wrong": { "type": "number" },
        "q1Total": { "type": "number" },
        "q2Total": { "type": "number" },
        "positiveMarks": { "type": "number" },
        "penaltyMarks": { "type": "number" },
        "q1PositiveMarks": { "type": "number" },
        "q2PositiveMarks": { "type": "number" },
        "q1PenaltyMarks": { "type": "number" },
        "q2PenaltyMarks": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "timeTakenMinutes": { "type": "number" },
        "rank": { "type": "number" },
        "totalCandidates": { "type": "number" },
        "percentile": { "type": "number" },
        "parseSource": {
          "type": "string",
          "enum": ["local_deterministic", "ai_free_tier", "manual"]
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "source", "date", "type", "score", "maxScore", "accuracy", "unattempted", "notes", "createdAt"]
    },
