        "subtopic",
        "format",
        "marks",
        "difficulty",
        "sourceTag",
        "sourceUrl",
        "prompt",
        "codeSnippet",
        "options",
        "correctOption",
        "correctOptions",
        "natAnswer",
        "natTolerance",
